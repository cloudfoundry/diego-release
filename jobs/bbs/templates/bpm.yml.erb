---
processes:
- name: bbs
  executable: /var/vcap/packages/bbs/bin/bbs
  args:
    - -config=/var/vcap/jobs/bbs/config/bbs.json
  hooks:
    pre_start: /var/vcap/jobs/bbs/bin/bpm-pre-start
  limits:
    <%
    if !p('limits.open_files').is_a?(Integer) || p('limits.open_files') <= 0
      raise "limits.open_files must be a positive integer"
    end
    %>
    open_files: <%= p('limits.open_files') %>
<%
  gogc = nil
  gomemlimit = nil
  if_p('diego.bbs.gogc') { |v| gogc = v }
  if_p('diego.bbs.gomemlimit') { |v| gomemlimit = v }
%>
<% if gogc || gomemlimit %>
  env:
  <% if gogc %>
    GOGC: '<%= gogc %>'
  <% end %>
  <% if gomemlimit %>
    GOMEMLIMIT: '<%= gomemlimit %>'
  <% end %>
<% end %>
