check process rep
  with pidfile /var/vcap/sys/run/bpm/rep/rep.pid
  start program "/var/vcap/jobs/bpm/bin/bpm start rep"
  stop program "/var/vcap/jobs/bpm/bin/bpm stop rep"
  group vcap
<% health_check_listen_addr = p('diego.rep.health_check_listen_addr') -%>
<% unless health_check_listen_addr.empty? -%>
<%
  host, port = health_check_listen_addr.match(/\A([^:]+):([0-9]+)\z/)&.captures
  unless port && (1..65535).cover?(port.to_i)
    raise "Invalid diego.rep.health_check_listen_addr '#{health_check_listen_addr}': must include a port between 1 and 65535"
  end
-%>
  if failed
    host <%= host %>
    port <%= port %>
    protocol http
    request "/health"
    with timeout 5 seconds
  for 15 cycles then alert
<% end -%>
